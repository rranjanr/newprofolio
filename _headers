# Cloudflare Pages header rules
# Purpose: cheaper Googlebot re-crawls (conditional requests), better CWV, basic security.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML: short cache so edits go live fast, but allow revalidation instead of full refetch.
/*.html
  Cache-Control: public, max-age=600, must-revalidate

/
  Cache-Control: public, max-age=600, must-revalidate

# Fingerprint-free static assets: long cache. Images were renamed in Aug 2026, so the
# filenames themselves act as the cache key.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

# Crawl-control files must stay fresh so Google picks up sitemap changes quickly.
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/llms-full.txt
  Cache-Control: public, max-age=3600
